# Somente para desenvolvimento local. Troque os valores antes de qualquer uso compartilhado.
POSTGRES_DB=tradutor
POSTGRES_USER=tradutor
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_PORT=5433
DATABASE_URL=postgres://tradutor:dev-only-change-me@postgres:5432/tradutor

S3_ACCESS_KEY=tradutor-local
S3_SECRET_KEY=dev-only-change-this-s3-secret
S3_ENDPOINT=http://object-storage:8333
S3_BUCKET=documents
S3_REGION=us-east-1

API_PORT=3000
WEB_PORT=5173
LOG_LEVEL=info

# Sessões (ADR-003). Use COOKIE_SECURE=true sempre que houver HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Limites de upload (ADR-006).
UPLOAD_MAX_FILE_MB=50
UPLOAD_MAX_BATCH_FILES=100
UPLOAD_MAX_BATCH_MB=1024

# Tradução automática gratuita (ADR-008). DeepL Free é opcional e envia o texto para fora (o Diretor escolhe em Configurações).
DEEPL_API_KEY=
# Gerenciamento AI (ADR-021): chave do Gemini (Google AI Studio). Vazia, a IA fica indisponível e o sistema segue normalmente.
GEMINI_API_KEY=
# Porta local do LibreTranslate; fora das faixas que o Windows costuma reservar (ex.: 5041-5140).
TRANSLATOR_PORT=15050

{
  "direction": "mesa de conferência editorial: grafite e cinza-azulado, ações pretas, sem verde, sem cartões",
  "sourceOfTruth": "apps/web/src/styles/tokens.css",
  "colors": {
    "light": {
      "canvas": "#f6f8fa",
      "surface": "#ffffff",
      "ghost": "#eaeef3",
      "ink": "#1a1e25",
      "ink2": "#424850",
      "muted": "#5d646c",
      "line": "#dce0e5",
      "primary": "#000000",
      "onPrimary": "#ffffff",
      "accent": "#3c5b8a",
      "accentSoft": "#e7effb",
      "menu": "#161a1f",
      "warning": "#804d18",
      "danger": "#aa2a27",
      "plum": "#71426d"
    },
    "dark": {
      "canvas": "#111418",
      "surface": "#191c20",
      "ghost": "#1e2227",
      "ink": "#eef0f3",
      "ink2": "#c0c4cb",
      "muted": "#a0a5ac",
      "line": "#2a2e33",
      "primary": "#f2f4f6",
      "onPrimary": "#000000",
      "accent": "#91b4e1",
      "accentSoft": "#1c2738",
      "menu": "#0a0c10",
      "warning": "#e7b369",
      "danger": "#f08f87",
      "plum": "#cf9fc9"
    },
    "charts": {
      "light": ["#4e78c7", "#af7528", "#744276", "#c6ccd3"],
      "dark": ["#5695e0", "#bd871c", "#9e5598", "#3a3f46"],
      "sequential": "one hue (steel blue), light to dark, own steps in dark",
      "validated": "CVD-safe in both themes"
    },
    "noGreen": true,
    "legacyAliases": ["--ink", "--paper", "--sheet", "--rule", "--ok", "--menu-*", "--chart-*"],
    "semanticUtilities": ["bg-canvas", "bg-surface", "bg-ghost", "text-ink", "text-ink-2", "text-muted", "text-accent", "border-line"]
  },
  "typography": {
    "family": "Schibsted Grotesk Variable",
    "display": "same family, weight 740-780",
    "body": "15px",
    "bodyLineHeight": 1.5,
    "labels": "13-14px",
    "numbers": "tabular-nums, no monospace"
  },
  "radius": {
    "control": "10px",
    "panel": "12px",
    "dialog": "16px",
    "buttons": "pill"
  },
  "borders": "hairline only where it groups; no card frames",
  "shadow": "windows, menus and tips only",
  "layout": {
    "density": "balanced",
    "navigation": "dark fixed sidebar with icon groups; compact top bar with Ctrl+K search, bell panel, theme and account menu; mobile bottom bar with Mais sheet",
    "documents": "flowing ghost rows with the flow-line glyph; no cards",
    "dashboard": "KPI ledger, proportional live register, charts in a grid separated by hairlines",
    "settings": "secondary menu on the left",
    "signature": "linha do fluxo: six segments at row, header and register scales",
    "icons": "thin stroke 1.5, navigation and main actions only"
  },
  "documentPreview": {
    "paper": "white in both themes",
    "typography": "actual document fonts and measures",
    "preserveDynamicGeometry": [
      "table widths and merged cells",
      "alignment",
      "PDF canvas resolution",
      "page and zoom",
      "progress",
      "chart coordinates and intensity",
      "anchored popup position"
    ]
  },
  "implementation": {
    "tailwind": "4.3.3",
    "integration": "@tailwindcss/vite",
    "entry": "apps/web/src/style.css",
    "modules": [
      "styles/tokens.css",
      "styles/foundation.css",
      "styles/domain.css",
      "styles/components.css",
      "LanguagePairPicker.css",
      "styles/account.css",
      "styles/documents.css",
      "styles/administration.css",
      "styles/analytics.css"
    ],
    "layers": ["base", "components", "utilities"],
    "fonts": "@fontsource-variable/schibsted-grotesk",
    "components": ["icons.tsx", "CommandPalette.tsx", "BellPanel.tsx", "ui.tsx LoadingLine/LoadingHint", "Flow.tsx FlowGlyph"]
  },
  "motion": {
    "fast": "120ms",
    "normal": "180ms",
    "slow": "240ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "grammar": "ghost: blur + opacity materialize",
    "reducedMotion": "respected"
  },
  "constraints": {
    "scope": "visual only",
    "preserve": [
      "endpoints",
      "permissions",
      "requests",
      "callbacks",
      "validation",
      "approval flow",
      "confirmations",
      "accessibility",
      "generated documents"
    ]
  },
  "evidence": {
    "codeAudit": "docs/design/visual-audit.md",
    "browserValidationRecord": "docs/design/visual-validation.md",
    "browserValidationStatus": "captured with Playwright: 3 roles, light/dark, desktop/mobile; no page errors; no horizontal overflow at 375px",
    "acceptanceStatus": "prototype approved by owner 2026-10-25"
  },
  "loading": "thin line under the top bar plus a small three-dot hint; no boxes"
}

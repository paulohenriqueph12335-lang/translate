{
  "name": "@tradutor/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "prettier --check src package.json tsconfig.json",
    "test": "node --env-file-if-exists=../../.env --import tsx --test \"src/**/*.test.ts\"",
    "migrate": "tsx src/scripts/migrate.ts",
    "encryption": "tsx src/scripts/encryption.ts",
    "bootstrap:director": "tsx src/scripts/bootstrap-director.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@tradutor/core": "workspace:*",
    "fastify": "5.12.7",
    "jszip": "3.10.1",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.8.1",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6"
  }
}
